{
  "name": "tecniflow",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings=0",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts tests/auth.test.mjs",
    "test:e2e": "node scripts/test-chromium.mjs && node --import tsx tests/e2e.ts",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "1.1.1",
    "drizzle-orm": "0.45.2",
    "next": "16.4.3",
    "pdf-lib": "1.17.1",
    "postgres": "3.4.9",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.13",
    "@electric-sql/pglite-socket": "0.2.16",
    "@fontsource/inter": "5.3.0",
    "@playwright/test": "1.64.1",
    "@sparticuz/chromium": "153.0.0",
    "@types/node": "24.10.1",
    "@types/pngjs": "6.0.5",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.1",
    "eslint-config-next": "16.4.3",
    "jsqr": "1.4.0",
    "pngjs": "7.0.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
